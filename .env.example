# Server Configuration
# Port on which the HTTP server will listen
# Default: 8080
SERVER_PORT=8080

# Cache Configuration
# Time-to-live for cached search results in seconds
# Default: 30
CACHE_TTL_SECONDS=30

# Rate Limiting Configuration
# Maximum number of requests allowed per IP address within the rate limit window
# Default: 10
RATE_LIMIT_MAX_REQUESTS=10

# Duration of the rate limit window in minutes
# Default: 1
RATE_LIMIT_WINDOW_MINUTES=1

# Provider Configuration
# Timeout for provider API calls in seconds
# Default: 2
PROVIDER_TIMEOUT_SECONDS=2
